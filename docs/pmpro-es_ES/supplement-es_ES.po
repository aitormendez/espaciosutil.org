#: classes/email-templates/class-pmpro-email-template-billing-admin.php:73
msgid "Billing information has been updated for {{ user_login }} at {{ sitename }}"
msgstr "Se han actualizado los datos de facturación de {{ user_login }} en {{ sitename }}"

#: classes/email-templates/class-pmpro-email-template-billing-admin.php:77
msgid "<p>The billing information for {{ display_name }} at {{ sitename }} has been changed.</p>\n\n<p>Account: {{ display_name }} ({{ user_email }})</p>\n\n<p>\n\tBilling Information:<br />\n\t{{ billing_address }}\n</p>\n\n{% if accountnumber %}<p>\n\t{{ cardtype }}: {{ accountnumber }}<br />\n\tExpires: {{ expirationmonth }}/{{ expirationyear }}\n</p>{% endif %}\n\n<p>Log in to your WordPress admin here: {{ login_url }}</p>"
msgstr "<p>Los datos de facturación de {{ display_name }} en {{ sitename }} se han actualizado.</p>\n\n<p>Cuenta: {{ display_name }} ({{ user_email }})</p>\n\n<p>\n\tDatos de facturación:<br />\n\t{{ billing_address }}\n</p>\n\n{% if accountnumber %}<p>\n\t{{ cardtype }}: {{ accountnumber }}<br />\n\tCaduca: {{ expirationmonth }}/{{ expirationyear }}\n</p>{% endif %}\n\n<p>Accede a la administración de WordPress aquí: {{ login_url }}</p>"

#: classes/email-templates/class-pmpro-email-template-billing-failure-admin.php:73
msgid "Membership payment failed for {{ display_name }} at {{ sitename }}"
msgstr "No se ha podido cobrar la membresía de {{ display_name }} en {{ sitename }}"

#: classes/email-templates/class-pmpro-email-template-billing-failure-admin.php:84
msgid "<p>The subscription payment for {{ user_login }} for level {{ membership_level_name }} at {{ sitename }} has failed.</p>\n\n<p>Account: {{ display_name }} ({{ user_email }})</p>\n\n<p>Membership Level: {{ membership_level_name }}</p>\n\n<p>Log in to your WordPress admin here: {{ login_url }}</p>"
msgstr "<p>No se ha podido cobrar el pago de la suscripción de {{ user_login }} al nivel {{ membership_level_name }} en {{ sitename }}.</p>\n\n<p>Cuenta: {{ display_name }} ({{ user_email }})</p>\n\n<p>Nivel de membresía: {{ membership_level_name }}</p>\n\n<p>Accede a la administración de WordPress aquí: {{ login_url }}</p>"

#: classes/email-templates/class-pmpro-email-template-billing-failure.php:73
msgid "Membership payment failed at {{ sitename }}"
msgstr "No se ha podido cobrar tu membresía en {{ sitename }}"

#: classes/email-templates/class-pmpro-email-template-billing-failure.php:84
msgid "<p>The current subscription payment for level {{ membership_level_name }} at {{ sitename }} has failed.</p>\n\n<p>\n\t<strong>Please click the following link to log in and update your billing information to avoid account suspension.</strong><br />\n\t{{ login_url }}\n</p>\n\n<p>Account: {{ display_name }} ({{ user_email }})</p>"
msgstr "<p>No se ha podido cobrar el pago de tu suscripción al nivel {{ membership_level_name }} en {{ sitename }}.</p>\n\n<p>\n\t<strong>Accede al siguiente enlace y actualiza tus datos de facturación para evitar la suspensión de tu cuenta.</strong><br />\n\t{{ login_url }}\n</p>\n\n<p>Cuenta: {{ display_name }} ({{ user_email }})</p>"

#: classes/email-templates/class-pmpro-email-template-billing.php:73
msgid "Your billing information has been updated at {{ sitename }}"
msgstr "Tus datos de facturación en {{ sitename }} se han actualizado"

#: classes/email-templates/class-pmpro-email-template-billing.php:84
msgid "<p>Your billing information at {{ sitename }} has been changed.</p>\n\n<p>Account: {{ display_name }} ({{ user_email }})</p>\n\n<p>\n\tBilling Information:<br />\n\t{{ billing_address }}\n</p>\n\n{% if accountnumber %}<p>\n\t{{ cardtype }}: {{ accountnumber }}<br />\n\tExpires: {{ expirationmonth }}/{{ expirationyear }}\n</p>{% endif %}\n\n<p>If you did not request a billing information change please contact us at {{ siteemail }}</p>\n\n<p>Log in to your membership account here: {{ login_url }}</p>"
msgstr "<p>Tus datos de facturación en {{ sitename }} se han actualizado.</p>\n\n<p>Cuenta: {{ display_name }} ({{ user_email }})</p>\n\n<p>\n\tDatos de facturación:<br />\n\t{{ billing_address }}\n</p>\n\n{% if accountnumber %}<p>\n\t{{ cardtype }}: {{ accountnumber }}<br />\n\tCaduca: {{ expirationmonth }}/{{ expirationyear }}\n</p>{% endif %}\n\n<p>Si no has solicitado este cambio en tus datos de facturación, contacta con nosotros en {{ siteemail }}</p>\n\n<p>Accede a tu cuenta aquí: {{ login_url }}</p>"

#: classes/email-templates/class-pmpro-email-template-cancel-admin.php:76
msgid "Membership for {{ user_login }} at {{ sitename }} has been CANCELLED"
msgstr "La membresía de {{ user_login }} en {{ sitename }} se ha CANCELADO"

#: classes/email-templates/class-pmpro-email-template-cancel-admin.php:87
msgid "<p>The membership for {{ user_login }} at {{ sitename }} has been cancelled.</p>\n\n<p>Account: {{ display_name }} ({{ user_email }})</p>\n\n<p>Membership Level: {{ membership_level_name }}</p>\n\n{% if startdate %}<p>Start Date: {{ startdate }}</p>{% endif %}\n\n{% if enddate %}<p>End Date: {{ enddate }}</p>{% endif %}\n\n<p>Log in to your WordPress admin here: {{ login_url }}</p>"
msgstr "<p>La membresía de {{ user_login }} en {{ sitename }} se ha cancelado.</p>\n\n<p>Cuenta: {{ display_name }} ({{ user_email }})</p>\n\n<p>Nivel de membresía: {{ membership_level_name }}</p>\n\n{% if startdate %}<p>Fecha de inicio: {{ startdate }}</p>{% endif %}\n\n{% if enddate %}<p>Fecha de fin: {{ enddate }}</p>{% endif %}\n\n<p>Accede a la administración de WordPress aquí: {{ login_url }}</p>"

#: classes/email-templates/class-pmpro-email-template-cancel-on-next-payment-date-admin.php:72
msgid "Payment subscription for {{ user_login }} at {{ sitename }} has been CANCELLED"
msgstr "Los pagos recurrentes de la suscripción de {{ user_login }} en {{ sitename }} se han CANCELADO"

#: classes/email-templates/class-pmpro-email-template-cancel-on-next-payment-date-admin.php:83
msgid "<p>The payment subscription for {{ user_login }} at {{ sitename }} has been cancelled.</p>\n\n<p>Account: {{ display_name }} ({{ user_email }})</p>\n\n<p>Membership Level: {{ membership_level_name }}</p>\n\n<p>Start Date: {{ startdate }}</p>\n\n<p>Expiration Date: {{ enddate }}</p>\n\n<p>Log in to your WordPress admin here: {{ login_url }}</p>"
msgstr "<p>Se han cancelado los pagos recurrentes de la suscripción de {{ user_login }} en {{ sitename }}.</p>\n\n<p>Cuenta: {{ display_name }} ({{ user_email }})</p>\n\n<p>Nivel de membresía: {{ membership_level_name }}</p>\n\n<p>Fecha de inicio: {{ startdate }}</p>\n\n<p>Fecha de caducidad: {{ enddate }}</p>\n\n<p>Accede a la administración de WordPress aquí: {{ login_url }}</p>"

