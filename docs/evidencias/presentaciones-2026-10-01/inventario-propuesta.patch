+import copy
+import tempfile
+import unittest
+import unicodedata
+from pathlib import Path
+from unittest.mock import patch
+
+from scripts import cde_inventory_scan as scan
+from scripts import cde_inventory_reconcile as reconcile
+from tests.test_cde_inventory_sync import inventory_row
+from tests.test_cde_inventory_reconcile import planning_row, negative_external_evidence
+from tests.test_cde_inventory_reconcile_integration import InMemoryNocoDB
+
+
+class PresentationInventoryTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.lesson = self.root / '01 - Urantia/00 - Presentacion/0.1 - Leccion'
+        self.lesson.mkdir(parents=True)
+
+    def pdf(self, lesson=None, name='original.pdf'):
+        folder = (lesson or self.lesson) / 'Presentación'
+        folder.mkdir(exist_ok=True, parents=True)
+        path = folder / name
+        path.write_bytes(b'%PDF-1.7\nfixture\n%%EOF\n')
+        return path
+
+    def report(self, local, remote, **kwargs):
+        return reconcile.build_reconcile_report(
+            scanned_rows=[local], existing_records=[{'id': 7, 'fields': remote}],
+            external_evidence=[], scope={'kind': 'focused', 'claves': [local['clave_leccion']]},
+            **kwargs)
+
+    def test_pdf_only_lesson_is_discovered_with_relative_path(self):
+        pdf = self.pdf()
+        result = scan.build_scan_report(self.root)
+        self.assertEqual(result['warnings'], [])
+        self.assertEqual(len(result['rows']), 1)
+        self.assertEqual(result['rows'][0]['presentacion_pdf_ruta'], str(pdf.relative_to(self.root)))
+        self.assertFalse(result['rows'][0]['tiene_video_exportado'])
+
+    def test_reading_pdf_does_not_become_presentation(self):
+        (self.lesson / 'lectura.pdf').write_bytes(b'%PDF-1.7')
+        self.assertEqual(scan.build_scan_report(self.root)['rows'], [])
+
+    def test_no_presentation_is_optional(self):
+        (self.lesson / 'video.mkv').touch()
+        result = scan.build_scan_report(self.root)
+        self.assertEqual(result['warnings'], [])
+        self.assertEqual(result['rows'][0]['presentacion_pdf_ruta'], '')
+
+    def test_unicode_folder_and_uppercase_extension(self):
+        pdf = self.pdf(name='original.PDF')
+        pdf.parent.rename(pdf.parent.with_name(unicodedata.normalize('NFD', 'Presentación')))
+        result = scan.build_scan_report(self.root)
+        self.assertEqual(result['warnings'], [])
+        self.assertTrue(result['rows'][0]['presentacion_pdf_ruta'].endswith('original.PDF'))
+
+    def test_nested_lesson_does_not_supply_parent_presentation(self):
+        (self.lesson / 'video.mkv').touch()
+        child = self.lesson / '0.1.1 - Otra'
+        pdf = self.pdf(child)
+        rows = {r['clave_leccion']: r for r in scan.build_scan_report(self.root)['rows']}
+        self.assertEqual(rows['cde:01:00:0.1']['presentacion_pdf_ruta'], '')
+        self.assertEqual(rows['cde:01:00:0.1.1']['presentacion_pdf_ruta'], str(pdf.relative_to(self.root)))
+
+    def test_ambiguous_pdf_blocks_writes(self):
+        self.pdf(); self.pdf(name='otro.pdf')
+        scanned = scan.build_scan_report(self.root)
+        self.assertEqual(scanned['warnings'][0]['kind'], 'presentation_invalid')
+        result = self.report(scanned['rows'][0], inventory_row(), scan_warnings=scanned['warnings'])
+        self.assertFalse(result['preconditions']['passed'])
+
+    def test_empty_and_corrupt_presentation_folders_report_error(self):
+        pdf = self.pdf()
+        for content in (b'', b'not a PDF'):
+            pdf.write_bytes(content)
+            self.assertEqual(scan.build_scan_report(self.root)['warnings'][0]['kind'], 'presentation_invalid')
+        pdf.unlink()
+        self.assertEqual(scan.build_scan_report(self.root)['warnings'][0]['kind'], 'presentation_invalid')
+
+    def test_unreadable_pdf_blocks_instead_of_clearing(self):
+        pdf = self.pdf()
+        with patch.object(Path, 'open', side_effect=PermissionError('unreadable')):
+            report = scan.build_scan_report(self.root)
+        self.assertEqual(report['warnings'][0]['kind'], 'presentation_invalid')
+
+    def test_symlink_file_and_container_are_rejected(self):
+        pdf = self.pdf()
+        external = self.root / 'external.pdf'; external.write_bytes(pdf.read_bytes())
+        pdf.unlink(); pdf.symlink_to(external)
+        self.assertEqual(scan.build_scan_report(self.root)['warnings'][0]['kind'], 'presentation_invalid')
+        pdf.unlink(); pdf.parent.rmdir()
+        folder = self.root / 'external'; folder.mkdir(); (folder / 'a.pdf').write_bytes(b'%PDF-1.7')
+        (self.lesson / 'Presentación').symlink_to(folder, target_is_directory=True)
+        self.assertEqual(scan.build_scan_report(self.root)['warnings'][0]['kind'], 'presentation_invalid')
+
+    def test_fill_readback_and_repeat_are_idempotent(self):
+        pdf = self.pdf()
+        local = scan.build_scan_report(self.root)['rows'][0]
+        remote = copy.deepcopy(local); remote['presentacion_pdf_ruta'] = None
+        records = [{'id': 7, 'fields': remote}]; store = InMemoryNocoDB(records)
+        first = self.report(local, remote, apply=True, write_executor=store.apply)
+        self.assertTrue(first['preconditions']['passed'])
+        self.assertEqual(first['writes_performed'], 1)
+        self.assertEqual(remote['presentacion_pdf_ruta'], str(pdf.relative_to(self.root)))
+        self.assertEqual(self.report(local, remote)['planned_writes'], [])
+
+    def test_invalid_registered_paths_are_preserved_and_blocked(self):
+        self.pdf();local = scan.build_scan_report(self.root)['rows'][0]
+        for value in ['/Users/aitor/Library/CloudStorage/Dropbox/a.pdf', '../escape.pdf',
+                      'missing.pdf', '02 - Seth/00 - Presentacion/0.1 - Otra/Presentación/a.pdf']:
+            with self.subTest(value=value):
+                remote = copy.deepcopy(local);remote['presentacion_pdf_ruta'] = value
+                result = self.report(local, remote)
+                self.assertFalse(result['preconditions']['passed'])
+                self.assertEqual(result['planned_writes'], [])
+                self.assertEqual(remote['presentacion_pdf_ruta'], value)
+
+    def test_deleted_registered_pdf_never_clears_remote_reference(self):
+        pdf = self.pdf();remote = scan.build_scan_report(self.root)['rows'][0]
+        (self.lesson / 'video.mkv').touch();pdf.unlink();pdf.parent.rmdir()
+        local = scan.build_scan_report(self.root)['rows'][0]
+        result = self.report(local, remote)
+        self.assertFalse(result['preconditions']['passed'])
+        self.assertEqual(result['planned_writes'], [])
+
+    def test_missing_optional_column_does_not_trigger_empty_write(self):
+        local = inventory_row();remote = copy.deepcopy(local);remote.pop('presentacion_pdf_ruta')
+        self.assertEqual(self.report(local, remote)['planned_writes'], [])
+
+    def test_presentation_reference_prevents_planning_only_classification(self):
+        fields = planning_row(presentacion_pdf_ruta='registered.pdf')
+        key = fields['clave_leccion']
+        result = reconcile.build_reconcile_report(scanned_rows=[], existing_records=[{'id':8,'fields':fields}],
+            external_evidence=[negative_external_evidence(key)], scope={'kind':'complete','claves':[]})
+        self.assertEqual(result['planning_only'], [])
+        self.assertFalse(result['preconditions']['passed'])
+
+
+if __name__ == '__main__':
+    unittest.main()
