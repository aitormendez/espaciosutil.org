+def presentation_folders(lesson_dir: Path) -> list[Path]:
+    """Only the dedicated direct folder identifies slides, never other readings."""
+    return [path for path in lesson_dir.iterdir()
+            if normalize_filesystem_name(path.name) == "Presentación"]
+
+
+def find_presentation_pdf(series_root: Path, lesson_dir: Path) -> str:
+    folders = presentation_folders(lesson_dir)
+    if not folders:
+        return ""
+    if len(folders) != 1:
+        raise ValueError("multiple presentation folders")
+    folder = folders[0]
+    relative = folder.relative_to(series_root)
+    current = series_root
+    for part in relative.parts:
+        current = current / part
+        if current.is_symlink():
+            raise ValueError("presentation path contains a symlink")
+    if not folder.is_dir():
+        raise ValueError("presentation container is not a directory")
+    candidates = [p for p in folder.iterdir() if p.suffix.lower() == ".pdf" and not p.name.startswith(".")]
+    if not candidates:
+        raise ValueError("presentation folder has no PDF")
+    if len(candidates) != 1:
+        raise ValueError("multiple presentation PDFs")
+    pdf = candidates[0]
+    if not stat.S_ISREG(pdf.lstat().st_mode):
+        raise ValueError("presentation PDF is not a regular file")
+    if not pdf.resolve().is_relative_to(series_root.resolve()):
+        raise ValueError("presentation PDF escapes Series CDE")
+    with pdf.open("rb") as stream:
+        if stream.read(5) != b"%PDF-":
+            raise ValueError("presentation file has no PDF signature")
+    return str(pdf.relative_to(series_root))
 
 
