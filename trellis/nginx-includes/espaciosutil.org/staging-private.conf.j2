{% if env == 'staging' %}
{% if staging_public_access | default(false) | bool %}
# Acceso público de demostración; el aislamiento de staging permanece en WordPress.
allow all;
{% else %}
# Staging privado durante la copia y las pruebas con datos reales.
allow 127.0.0.1;
allow ::1;
{% for address in (staging_cde_tailscale_clients if staging_cde_tailscale_enabled | default(false) else vault_staging_allowed_ips) %}
allow {{ address }};
{% endfor %}
deny all;
{% endif %}
if (-f /srv/www/espaciosutil.org/shared/staging-import.lock) { return 503; }
{% endif %}
